{
  "name": "serifwriter",
  "private": true,
  "version": "0.1.0",
  "description": "A private, offline, local-first writing app that typesets your words into book pages as you write.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "npm run build && npm run preview",
    "test": "node --test --experimental-strip-types tests/unit/",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "typescript": "^5.6.3",
    "vite": "^7.3.8"
  }
}
